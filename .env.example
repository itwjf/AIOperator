# ============================================
# AIOperator 环境变量模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================

# === LLM 配置（阿里云 DashScope / 百炼平台）===
DASHSCOPE_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# === Milvus 向量数据库 ===
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=aiops_knowledge
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# === 数据库 MCP Server（MySQL）===
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=aioperator
DB_BLACKLIST_TABLES=

# === MCP Server 地址（Docker 用容器名，本地开发用 127.0.0.1）===
MCP_TIME_URL=http://mcp-time:8003/mcp
MCP_DB_URL=http://mcp-db:8004/mcp
MCP_PPT_URL=http://mcp-ppt:8005/mcp
MCP_DOCKER_URL=http://mcp-docker:8006/mcp
MCP_SEARCH_URL=http://mcp-search:8007/mcp

# === Web 搜索 MCP Server ===
# Tavily API Key（可选，不填则自动降级 DuckDuckGo）
# 申请地址: https://app.tavily.com
TAVILY_API_KEY=

# === 日志配置 ===
LOG_LEVEL=INFO
LOG_DIR=logs

# === 应用配置 ===
APP_HOST=0.0.0.0
APP_PORT=9900
DEBUG=false

# === 对话历史持久化（SQLite 检查点存储）===
# Docker 中挂载到 volume，服务重启后对话历史不丢失
# 本地开发默认 data/ 目录
CHECKPOINT_DIR=data

# === 数据库配置（MySQL）===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=aioperator

# === 认证配置 ===
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# === GitHub OAuth ===
# 在 https://github.com/settings/developers 创建 OAuth App 获取
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://127.0.0.1:9900/api/auth/github/callback

# === MCP 安全 ===
# 生成方式同 JWT_SECRET_KEY
MCP_SECRET_TOKEN=change-me-to-another-random-secret

# === LangSmith 可观测性 ===
# 在 https://smith.langchain.com 注册获取 API Key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=aioperator
