# ============================================
# AIOperator 环境变量模板
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ============================================

# === LLM 配置（阿里云 DashScope / 百炼平台）===
DASHSCOPE_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# === Milvus 向量数据库 ===
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=aiops_knowledge
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# === 数据库 MCP Server（MySQL）===
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=aioperator
DB_BLACKLIST_TABLES=

# === MCP Server 地址（Docker 用容器名，本地开发用 127.0.0.1）===
MCP_TIME_URL=http://mcp-time:8003/mcp
MCP_DB_URL=http://mcp-db:8004/mcp
MCP_PPT_URL=http://mcp-ppt:8005/mcp
MCP_DOCKER_URL=http://mcp-docker:8006/mcp
MCP_SEARCH_URL=http://mcp-search:8007/mcp

# === Web 搜索 MCP Server ===
# Tavily API Key（可选，不填则自动降级 DuckDuckGo）
# 申请地址: https://app.tavily.com
TAVILY_API_KEY=

# === 日志配置 ===
LOG_LEVEL=INFO
LOG_DIR=logs

# === 应用配置 ===
APP_HOST=0.0.0.0
APP_PORT=9900
DEBUG=false

# === 对话历史持久化（SQLite 检查点存储）===
# Docker 中挂载到 volume，服务重启后对话历史不丢失
# 本地开发默认 data/ 目录
CHECKPOINT_DIR=data
